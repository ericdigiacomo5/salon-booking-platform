generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator workers {
  provider = "prisma-client"
  output   = "../src/generated/prisma-workers"
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

model ServiceCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  position  Int
  color     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  services Service[]
}

model Service {
  id              String          @id @default(cuid())
  name            String
  description     String?
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  durationMinutes Int
  priceCents      Int
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())

  appointmentServices          AppointmentService[]
  recurringAppointmentServices RecurringAppointmentService[]
  payTerms                     ServicePayTerms?
  artists                      ArtistService[]

  @@index([categoryId])
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  phone              String
  passwordHash       String?
  passwordChangedAt  DateTime?
  sessionsRevokedAt  DateTime?
  role               Role      @default(CUSTOMER)
  createdAt          DateTime  @default(now())
  creditBalanceCents Int       @default(0)

  smsOptIn              Boolean   @default(false)
  smsPhone              String?
  smsConfirmedAt        DateTime?
  smsConfirmRequestedAt DateTime?

  appointments            Appointment[]
  accounts                Account[]
  sessions                Session[]
  recurringAppointments   RecurringAppointment[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  creditEntries           CreditEntry[]            @relation("CreditEntryUser")
  creditEntriesCreated    CreditEntry[]            @relation("CreditEntryCreatedBy")
  giftCardsIssued         GiftCard[]               @relation("GiftCardIssuedBy")
  giftCardsRedeemed       GiftCard[]               @relation("GiftCardRedeemedBy")
  giftCardsVoided         GiftCard[]               @relation("GiftCardVoidedBy")
  smsConsentEvents        SmsConsentEvent[]
  smsMessages             SmsMessage[]
  retailPurchases         RetailSale[]             @relation("RetailSaleCustomer")
  retailSalesRungUp       RetailSale[]             @relation("RetailSaleCreatedBy")
  retailSalesVoided       RetailSale[]             @relation("RetailSaleVoidedBy")

  @@index([smsPhone])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Artist {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  photoUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  portfolio             PortfolioImage[]
  availability          Availability[]
  timeOff               TimeOff[]
  appointments          Appointment[]
  slots                 AppointmentSlot[]
  recurringAppointments RecurringAppointment[]
  payTerms              ArtistPayTerms?
  retailPayTerms        ArtistRetailPayTerms?
  retailSales           RetailSale[]
  services              ArtistService[]
}

model ArtistService {
  artistId  String
  serviceId String

  artist  Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([artistId, serviceId])
  @@index([serviceId])
}

model PortfolioImage {
  id        String   @id @default(cuid())
  artistId  String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum RecurringStatus {
  ACTIVE
  CANCELLED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum PaymentMethod {
  CASH
  CARD
  GROUPON
  OTHER
}

model RecurringAppointment {
  id            String          @id @default(cuid())
  userId        String
  artistId      String
  dayOfWeek     Int
  startTime     String
  intervalWeeks Int
  seriesStart   DateTime
  seriesEnd     DateTime
  status        RecurringStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())

  user               User                          @relation(fields: [userId], references: [id])
  artist             Artist                        @relation(fields: [artistId], references: [id])
  services           RecurringAppointmentService[]
  appointments       Appointment[]
  skippedOccurrences RecurringSkippedOccurrence[]
}

model RecurringAppointmentService {
  id                     String @id @default(cuid())
  recurringAppointmentId String
  serviceId              String
  position               Int

  recurringAppointment RecurringAppointment @relation(fields: [recurringAppointmentId], references: [id], onDelete: Cascade)
  service              Service              @relation(fields: [serviceId], references: [id])

  @@unique([recurringAppointmentId, serviceId])
}

model RecurringSkippedOccurrence {
  id                     String   @id @default(cuid())
  recurringAppointmentId String
  occurrenceDate         String
  reason                 String
  createdAt              DateTime @default(now())

  recurringAppointment RecurringAppointment @relation(fields: [recurringAppointmentId], references: [id], onDelete: Cascade)

  @@unique([recurringAppointmentId, occurrenceDate])
}

model Appointment {
  id                     String            @id @default(cuid())
  userId                 String
  artistId               String
  startTime              DateTime
  endTime                DateTime
  status                 AppointmentStatus @default(PENDING)
  createdAt              DateTime          @default(now())
  recurringAppointmentId String?
  paymentMethod          PaymentMethod?
  checkedOutAt           DateTime?
  discountType           DiscountType?
  discountValue          Int?
  creditAppliedCents     Int               @default(0)
  reminderSentAt         DateTime?
  smsReminderSentAt      DateTime?
  occurrenceDate         String?

  user                 User                  @relation(fields: [userId], references: [id])
  artist               Artist                @relation(fields: [artistId], references: [id])
  services             AppointmentService[]
  slots                AppointmentSlot[]
  recurringAppointment RecurringAppointment? @relation(fields: [recurringAppointmentId], references: [id])
  creditEntries        CreditEntry[]
  pay                  AppointmentPay?
  smsMessages          SmsMessage[]
  retailSales          RetailSale[]

  @@unique([recurringAppointmentId, occurrenceDate])
}

model AppointmentService {
  id              String @id @default(cuid())
  appointmentId   String
  serviceId       String
  position        Int
  priceCents      Int
  durationMinutes Int

  appointment Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service                @relation(fields: [serviceId], references: [id])
  pay         AppointmentServicePay?

  @@unique([appointmentId, serviceId])
}

model AppointmentSlot {
  id            String   @id @default(cuid())
  artistId      String
  slotStart     DateTime
  appointmentId String

  artist      Artist      @relation(fields: [artistId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([artistId, slotStart])
}

model Availability {
  id        String @id @default(cuid())
  artistId  String
  dayOfWeek Int
  startTime String
  endTime   String

  artist Artist @relation(fields: [artistId], references: [id])
}

model TimeOff {
  id        String    @id @default(cuid())
  artistId  String?
  date      DateTime
  endDate   DateTime?
  startTime String
  endTime   String

  artist Artist? @relation(fields: [artistId], references: [id])
}

enum CreditEntryKind {
  GIFT_CARD
  SPENT
  REVERSED
  ADJUSTMENT
}

model CreditEntry {
  id            String          @id @default(cuid())
  userId        String
  amountCents   Int
  kind          CreditEntryKind
  giftCardId    String?
  appointmentId String?
  retailSaleId  String?
  note          String?
  createdById   String
  createdAt     DateTime        @default(now())

  user        User         @relation("CreditEntryUser", fields: [userId], references: [id])
  createdBy   User         @relation("CreditEntryCreatedBy", fields: [createdById], references: [id])
  giftCard    GiftCard?    @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  retailSale  RetailSale?  @relation(fields: [retailSaleId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

enum GiftCardStatus {
  ISSUED
  REDEEMED
  VOID
}

model GiftCard {
  id               String         @id @default(cuid())
  codeHash         String?        @unique
  codeLast4        String?
  valueCents       Int
  status           GiftCardStatus @default(ISSUED)
  purchaserName    String?
  recipientName    String?
  issuedById       String
  issuedAt         DateTime       @default(now())
  redeemedByUserId String?
  redeemedAt       DateTime?
  voidedAt         DateTime?
  voidReason       String?
  voidedById       String?

  issuedBy      User          @relation("GiftCardIssuedBy", fields: [issuedById], references: [id])
  redeemedBy    User?         @relation("GiftCardRedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: Restrict)
  voidedBy      User?         @relation("GiftCardVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  creditEntries CreditEntry[]

  @@index([issuedAt])
}

model ArtistPayTerms {
  artistId              String   @id
  commissionBasisPoints Int
  updatedAt             DateTime @updatedAt

  artist Artist @relation(fields: [artistId], references: [id])
}

model ServicePayTerms {
  serviceId       String   @id
  serviceFeeCents Int
  updatedAt       DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id])
}

model AppointmentPay {
  appointmentId         String   @id
  commissionBasisPoints Int
  backfilled            Boolean  @default(false)
  createdAt             DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
}

model AppointmentServicePay {
  appointmentServiceId String @id
  serviceFeeCents      Int

  appointmentService AppointmentService @relation(fields: [appointmentServiceId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  saleItems RetailSaleItem[]
}

enum RetailSaleStatus {
  COMPLETED
  VOIDED
}

model RetailSale {
  id                  String           @id @default(cuid())
  status              RetailSaleStatus @default(COMPLETED)
  soldAt              DateTime
  userId              String?
  appointmentId       String?
  artistId            String?
  discountType        DiscountType?
  discountValue       Int?
  taxRateMillipercent Int
  taxCents            Int
  paymentMethod       PaymentMethod?
  creditAppliedCents  Int              @default(0)
  createdById         String
  createdAt           DateTime         @default(now())
  voidedAt            DateTime?
  voidedById          String?
  voidReason          String?

  user          User?            @relation("RetailSaleCustomer", fields: [userId], references: [id], onDelete: Restrict)
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  artist        Artist?          @relation(fields: [artistId], references: [id], onDelete: Restrict)
  createdBy     User             @relation("RetailSaleCreatedBy", fields: [createdById], references: [id])
  voidedBy      User?            @relation("RetailSaleVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  items         RetailSaleItem[]
  pay           RetailSalePay?
  creditEntries CreditEntry[]

  @@index([soldAt])
  @@index([appointmentId])
}

model RetailSaleItem {
  id             String @id @default(cuid())
  retailSaleId   String
  productId      String
  position       Int
  quantity       Int
  unitPriceCents Int

  retailSale RetailSale @relation(fields: [retailSaleId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([retailSaleId, productId])
}

model ArtistRetailPayTerms {
  artistId              String   @id
  commissionBasisPoints Int
  updatedAt             DateTime @updatedAt

  artist Artist @relation(fields: [artistId], references: [id])
}

model RetailSalePay {
  retailSaleId          String   @id
  commissionBasisPoints Int
  backfilled            Boolean  @default(false)
  createdAt             DateTime @default(now())

  retailSale RetailSale @relation(fields: [retailSaleId], references: [id])
}

model AppSettings {
  id                        Int     @id @default(1)
  bookingEnabled            Boolean @default(true)
  cancellationNoticeHours   Int     @default(24)
  maxSeriesWeeks            Int     @default(52)
  retailTaxRateMillipercent Int     @default(8625)
}

enum SmsConsentAction {
  OPTED_IN
  CONFIRMED
  OPTED_OUT
}

model SmsConsentEvent {
  id                String           @id @default(cuid())
  userId            String
  phone             String
  action            SmsConsentAction
  source            String
  disclosureVersion String?
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([phone, createdAt])
}

enum SmsKind {
  OPT_IN_REQUEST
  BOOKING_CONFIRMATION
  RECURRING_CONFIRMATION
  RESCHEDULE
  CANCELLATION
  RECURRING_CANCELLATION
  REMINDER
}

model SmsMessage {
  id            String   @id @default(cuid())
  userId        String
  appointmentId String?
  kind          SmsKind
  to            String
  body          String
  providerSid   String?  @unique
  status        String
  errorCode     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([userId, createdAt])
  @@index([appointmentId])
}

{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "demo-nail-salon",
    "routes": [
        { "pattern": "example.com", "custom_domain": true },
        { "pattern": "www.example.com", "custom_domain": true },
    ],
    "workers_dev": false,
    "preview_urls": false,
    "main": "cloudflare-worker.mjs",
    "triggers": { "crons": ["0 12-23,0-2 * * *"] },
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "html_handling": "none",
    },
    "compatibility_date": "2026-11-01",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "demo-nail-salon" }],
    "ratelimits": [
        { "name": "SIGN_IN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "ACCOUNT_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    ],
    "images": { "binding": "IMAGES" },
    "observability": { "enabled": true },
}
